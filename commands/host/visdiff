#!/usr/bin/env bash
#ddev-generated

## Description: Run visdiff in the DDEV Playwright container
## Usage: visdiff [args]
## Example: "ddev visdiff run --prepare"
## MutagenSync: true

set -euo pipefail

host_tool_dir="${DDEV_APPROOT}/.ddev/visdiff"
container_tool_dir="/var/www/html/.ddev/visdiff"

if [ ! -f "${host_tool_dir}/bin/visdiff.mjs" ]; then
  echo "visdiff: ${host_tool_dir}/bin/visdiff.mjs was not found" >&2
  exit 1
fi

platform_token="$(ddev exec --service web -- printenv PLATFORMSH_CLI_TOKEN 2>/dev/null || true)"

printf "%s\n" "${platform_token}" | ddev exec --service visdiff --dir /var/www/html -- bash -lc '
  set -euo pipefail

  platform_token=""
  IFS= read -r platform_token || true
  export PLATFORMSH_CLI_TOKEN="\${platform_token}"
  export USER=visdiff
  export HOME=/tmp

  nss_wrapper_lib="\$(find /usr/lib -name libnss_wrapper.so 2>/dev/null | head -n 1 || true)"
  if [ -n "\${nss_wrapper_lib}" ]; then
    printf "visdiff:x:%s:%s:visdiff:/tmp:/bin/bash\n" "\$(id -u)" "\$(id -g)" > /tmp/visdiff-passwd
    printf "visdiff:x:%s:\n" "\$(id -g)" > /tmp/visdiff-group
    export NSS_WRAPPER_PASSWD=/tmp/visdiff-passwd
    export NSS_WRAPPER_GROUP=/tmp/visdiff-group
    export LD_PRELOAD="\${nss_wrapper_lib}"
  fi

  tool_dir="\$1"
  shift

  if [ ! -d "\${tool_dir}/node_modules/playwright" ]; then
    if [ -f "\${tool_dir}/package-lock.json" ]; then
      npm --prefix "\${tool_dir}" ci
    else
      npm --prefix "\${tool_dir}" install
    fi
  fi

  node "\${tool_dir}/bin/visdiff.mjs" "\$@"
' bash "${container_tool_dir}" "$@"
